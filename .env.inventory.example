# ── 아마란스10 ERP API ────────────────────────────────────────
# API URL은 내부망(Tailscale IP) 또는 사내 서버 주소 사용
AMARANTH_API_URL=http://100.x.x.x:8080/api   # Tailscale IP
AMARANTH_API_KEY=your_amaranth_api_key_here

# ── Claude AI (레포트 생성) ───────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── 카카오톡 로그 / 생산 보고 파일 경로 ──────────────────────
# 카카오톡 PC 채팅방 내보내기 파일 (생산팀 단톡방)
KAKAO_LOG_PATH=C:/Users/PCuser/AppData/Local/Kakao/KakaoTalk/log/생산팀.txt

# 별도 생산 보고 텍스트 파일 (다른 방식으로 생산 보고 시)
PROD_REPORT_PATH=data/production_report.txt

# ── SQLite DB 경로 ───────────────────────────────────────────
DB_PATH=data/inventory.db
